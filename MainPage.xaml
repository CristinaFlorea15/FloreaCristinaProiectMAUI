<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FloreaCristinaProiect.MainPage"
             Title="Welcome">

    <ScrollView>
        <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            <!-- Logo -->
            <Image Source="pastries.jpg"
                   HeightRequest="200"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Pastries logo" />

            <!-- App Name -->
            <Label Text="Pastries!"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <!-- Description -->
            <Label Text="Welcome to our Pastries shop! Fresh and tasty!"
                   FontSize="18"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Buttons -->
            <Button Text="View Menu List"
                    Clicked="OnViewMenuListClicked"
                    HorizontalOptions="Fill"
                    HeightRequest="50" />

            <Button Text="View Your Shopping Cart"
                    Clicked="OnViewCartClicked"
                    HorizontalOptions="Fill"
                    HeightRequest="50" />

            <Button Text="Leave a Review"
                    Clicked="OnLeaveReviewClicked"
                    HorizontalOptions="Fill"
                    HeightRequest="50" />
        </StackLayout>
    </ScrollView>

</ContentPage>
