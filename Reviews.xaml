<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FloreaCristinaProiect.ReviewsPage"
             Title="Reviews">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add Review"
                     Clicked="OnAddReviewClicked" />
    </ContentPage.ToolbarItems>

    <StackLayout Padding="10">
        <!-- Title -->
        <Label Text="Customer Reviews"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0, 20, 0, 20" />

        <!-- Reviews List -->
        <CollectionView ItemsSource="{Binding Reviews}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0, 10" BorderColor="Gray" CornerRadius="10">
                        <Grid ColumnDefinitions="2*,3*,Auto" RowDefinitions="Auto,Auto">
                            <!-- Name -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding FullName}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />

                            <!-- Comment -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Comment}"
                                   FontSize="16"
                                   TextColor="Gray"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="Center" />

                            <!-- Stars -->
                            <Label Grid.Row="0" Grid.Column="2"
                                   Text="{Binding Stars, StringFormat='{0} ⭐'}"
                                   FontSize="14"
                                   TextColor="Gold"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />

                            <!-- Delete Button -->
                            <Button Grid.Row="1" Grid.Column="2"
                                    Text="🗑️"
                                    BackgroundColor="Transparent"
                                    TextColor="Red"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    VerticalOptions="End"
                                    HorizontalOptions="End"
                                    Clicked="OnDeleteReviewClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
