<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FloreaCristinaProiect.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FloreaCristinaProiect"
    Shell.FlyoutBehavior="Flyout"
    Title="FloreaCristinaProiect">

    <TabBar>
        <ShellContent
            Title="Pastries Menu" 
            ContentTemplate="{DataTemplate local:MainPage}"
        />
        
        <ShellContent
            Title="Pastries List"
            ContentTemplate="{DataTemplate local:PastriesListEntryPage}"
        />

        <ShellContent
            Title="Shopping Cart"
            ContentTemplate="{DataTemplate local:ShoppingCart}"
        />
        <ShellContent
            Title="Reviews"
            ContentTemplate="{DataTemplate local:ReviewsPage}"
        />
        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate local:AboutPage}"
        />

    </TabBar>

</Shell>
